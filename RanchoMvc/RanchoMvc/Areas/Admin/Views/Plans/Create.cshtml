@model RanchoMvc.Models.Plan
@{
    ViewBag.Title = "Nuevo Plan";
}

<div class="mb-4">
    <a href="@Url.Action("Index")" class="text-muted small text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i>Volver a Planes
    </a>
</div>

<div class="stat-card" style="max-width:700px">
    <h5 class="fw-semibold mb-4">Nuevo Plan</h5>
    @using (Html.BeginForm("Create", "Plans", new { area = "Admin" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fw-medium">Título <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-2">
                <label class="form-label fw-medium">Ícono (emoji)</label>
                @Html.TextBoxFor(m => m.Icon, new { @class = "form-control", placeholder = "🐴" })
            </div>
            <div class="col-md-2">
                <label class="form-label fw-medium">Orden</label>
                @Html.TextBoxFor(m => m.Order, new { @class = "form-control", type = "number" })
            </div>
            <div class="col-12">
                <label class="form-label fw-medium">Descripción corta</label>
                @Html.TextBoxFor(m => m.ShortDescription, new { @class = "form-control" })
            </div>
            <div class="col-12">
                <label class="form-label fw-medium">Descripción completa <span class="text-danger">*</span></label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "4" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6">
                <label class="form-label fw-medium">Precio (MXN)</label>
                @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01" })
            </div>
            <div class="col-md-6">
                <label class="form-label fw-medium">Etiqueta de precio</label>
                @Html.TextBoxFor(m => m.PriceLabel, new { @class = "form-control", placeholder = "desde $1,200 MXN / persona" })
            </div>
            <div class="col-12">
                <label class="form-label fw-medium">URL de imagen</label>
                @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", type = "url", placeholder = "https://..." })
            </div>
            <div class="col-12">
                <label class="form-label fw-medium">¿Qué incluye? <small class="text-muted">(separar con |)</small></label>
                @Html.TextBoxFor(m => m.Includes, new { @class = "form-control", placeholder = "Guía experto|Equipo de seguridad|Bebidas" })
            </div>
            <div class="col-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    <label class="form-check-label">Activo (visible en el sitio)</label>
                </div>
            </div>
            <div class="col-12 pt-2">
                <button type="submit" class="btn me-2" style="background:#2D5016;color:white;">Guardar Plan</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    }
</div>
