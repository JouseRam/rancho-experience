@model IEnumerable<RanchoMvc.Models.Plan>
@{
    ViewBag.Title = "Planes";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="mb-0 fw-semibold">Planes & Experiencias</h5>
        <p class="text-muted small mb-0">Gestiona los planes que se muestran en el sitio.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-sm" style="background:#2D5016;color:white;">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Plan
    </a>
</div>

<div class="stat-card p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:50px">#</th>
                    <th>Plan</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th>Orden</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="text-muted small">@p.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="@p.Icon" style="font-size:1.25rem;color:#2D5016;width:28px;text-align:center"></i>
                                <div>
                                    <div class="fw-medium">@p.Title</div>
                                    <div class="text-muted small">@p.ShortDescription</div>
                                </div>
                            </div>
                        </td>
                        <td class="small">@p.PriceLabel</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge badge-confirmed">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-cancelled">Inactivo</span>
                            }
                        </td>
                        <td class="small">@p.Order</td>
                        <td class="text-end">
                            <a href="@Url.Action("Edit", new { id = p.Id })" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @using (Html.BeginForm("Delete", "Plans", new { area = "Admin", id = p.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Eliminar este plan?')" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
