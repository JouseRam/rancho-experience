@model RanchoMvc.Models.Reservation
@{
    ViewBag.Title = "Detalle Cotización";
    var statuses = ViewBag.Statuses as string[];
    string badgeClass = Model.Status == "Confirmada" ? "badge-confirmed"
                      : Model.Status == "Cancelada"  ? "badge-cancelled"
                      : Model.Status == "Pendiente de Pago" ? "badge-pay"
                      : "badge-pending";

    var allSteps = new[] { "Pendiente", "Confirmada" };
    bool isCancelled = Model.Status == "Cancelada";

    var _displayName = string.IsNullOrEmpty(Model.CompanyName) ? Model.ContactName : Model.CompanyName;
    var _mailSubject = "mailto:" + Model.Email + "?subject=" + Uri.EscapeDataString("Cotización #" + Model.Id + " — " + _displayName);
    var _waPhone    = (Model.Phone ?? "").Replace("+","").Replace(" ","").Replace("-","");
    var _waText     = Uri.EscapeDataString("Hola " + Model.ContactName + ", te escribimos sobre tu cotización #" + Model.Id);
    var _waUrl      = "https://wa.me/" + _waPhone + "?text=" + _waText;
}

<div class="mb-3">
    <a href="@Url.Action("Index")" class="text-muted small text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i>Volver a Cotizaciones
    </a>
</div>

<div class="row g-3">
    <!-- Left column: info -->
    <div class="col-lg-8">

        <!-- Header card -->
        <div class="stat-card mb-3">
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                <div>
                    <h5 class="fw-semibold mb-1">
                        @(string.IsNullOrEmpty(Model.CompanyName) ? Model.ContactName : Model.CompanyName)
                        <span class="text-muted fw-normal" style="font-size:.85rem">#@Model.Id</span>
                    </h5>
                    <span class="badge @badgeClass fs-6">@Model.Status</span>
                </div>
                <div class="text-end">
                    <div class="text-muted small">Recibida</div>
                    <div class="fw-medium small">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>

            <!-- Timeline de estados -->
            @if (!isCancelled)
            {
                <div class="d-flex align-items-center gap-2 mt-3" style="overflow-x:auto">
                    @foreach (var step in allSteps)
                    {
                        bool done = Model.Status == "Confirmada" || step == "Pendiente";
                        bool current = Model.Status == step;
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <div style="width:26px;height:26px;border-radius:50%;border:2px solid @(done?"#2D5016":"#d1d5db");
                                        background:@(done?"#2D5016":"white");color:@(done?"white":"#9ca3af");
                                        display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700">
                                @(done ? Html.Raw("<i class='bi bi-check'></i>") : Html.Raw(""))
                            </div>
                            <span style="font-size:.8rem;font-weight:@(current?"600":"400");color:@(current?"#111827":"#6b7280")">@step</span>
                        </div>
                        if (step != allSteps[allSteps.Length - 1])
                        {
                            <div style="flex:1;height:2px;background:@(done&&Model.Status=="Confirmada"?"#2D5016":"#e5e7eb");min-width:32px"></div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="mt-3 d-flex align-items-center gap-2 text-danger" style="font-size:.85rem">
                    <i class="bi bi-x-circle-fill"></i> Esta cotización fue cancelada
                </div>
            }
        </div>

        <!-- Datos de contacto -->
        <div class="stat-card mb-3">
            <h6 class="fw-semibold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-person text-muted"></i> Información de contacto
            </h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Empresa / Grupo</label>
                    <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.CompanyName) ? "—" : Model.CompanyName)</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Contacto</label>
                    <p class="mb-0 fw-medium">@Model.ContactName</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Correo</label>
                    <p class="mb-0"><a href="mailto:@Model.Email">@Model.Email</a></p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Teléfono</label>
                    <p class="mb-0">
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <a href="tel:@Model.Phone">@Model.Phone</a>
                        }
                        else { <span>—</span> }
                    </p>
                </div>
            </div>
        </div>

        <!-- Detalles de la visita -->
        <div class="stat-card mb-3">
            <h6 class="fw-semibold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-calendar3 text-muted"></i> Detalles de la visita
            </h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Plan de interés</label>
                    <p class="mb-0 fw-medium">@(Model.Plan != null ? Model.Plan.Title : "No especificado")</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Fecha preferida</label>
                    <p class="mb-0 fw-medium">@(Model.PreferredDate.HasValue ? Model.PreferredDate.Value.ToString("dd/MM/yyyy") : "—")</p>
                </div>
                <div class="col-md-4">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Personas</label>
                    <p class="mb-0 fw-medium">@Model.GuestCount</p>
                </div>
                <div class="col-md-4">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Autos</label>
                    <p class="mb-0 fw-medium">@Model.NumberOfCars</p>
                </div>
                <div class="col-md-4">
                    <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Método de pago</label>
                    <p class="mb-0 fw-medium">@(Model.PaymentMethod == "online" ? "Online (tarjeta)" : "Ventanilla")</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="col-12">
                        <label class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em">Notas del cliente</label>
                        <p class="mb-0 fst-italic" style="color:#4b5563">@Model.Notes</p>
                    </div>
                }
                @if (Model.Plan != null && Model.Plan.Price > 0)
                {
                    <div class="col-12">
                        <div style="background:#f0f9f0;border-radius:10px;padding:.75rem 1rem;border:1px solid #d1fae5">
                            <span class="text-muted small">Estimado: </span>
                            <span class="fw-semibold" style="color:#2D5016">$@((Model.Plan.Price * Model.GuestCount).ToString("N0"))</span>
                            <span class="text-muted small"> (@Model.GuestCount personas × $@Model.Plan.Price.ToString("N0"))</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Notas del admin -->
        <div class="stat-card">
            <h6 class="fw-semibold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-muted"></i> Notas internas
                <span class="text-muted fw-normal" style="font-size:.72rem">(solo visibles para el equipo)</span>
            </h6>
            @using (Html.BeginForm("SaveAdminNotes", "Reservations", new { area = "Admin", id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <textarea name="adminNotes" class="form-control mb-2" rows="3"
                          placeholder="Agrega notas internas sobre esta cotización...">@Model.AdminNotes</textarea>
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-save me-1"></i>Guardar notas
                </button>
            }
        </div>
    </div>

    <!-- Right column: actions -->
    <div class="col-lg-4">

        <!-- Cambiar estado -->
        <div class="stat-card mb-3">
            <h6 class="fw-semibold mb-3">Cambiar estado</h6>
            @using (Html.BeginForm("UpdateStatus", "Reservations", new { area = "Admin", id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <select name="status" class="form-select">
                        @foreach (var s in statuses)
                        {
                            <option value="@s" @(Model.Status == s ? "selected" : "")>@s</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn w-100 fw-medium"
                        style="background:var(--ranch-green);color:white">
                    <i class="bi bi-arrow-repeat me-1"></i>Actualizar estado
                </button>
            }
            <p class="text-muted mt-2 mb-0" style="font-size:.7rem">
                Al confirmar o cancelar se enviará un correo al cliente.
            </p>
        </div>

        <!-- Acciones rápidas -->
        <div class="stat-card mb-3">
            <h6 class="fw-semibold mb-3">Acciones rápidas</h6>
            <div class="d-flex flex-column gap-2">
                <a href="@_mailSubject"
                   class="btn btn-sm btn-outline-secondary w-100 text-start">
                    <i class="bi bi-envelope me-2"></i>Responder por email
                </a>
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <a href="@_waUrl"
                       target="_blank"
                       class="btn btn-sm btn-outline-secondary w-100 text-start">
                        <i class="bi bi-whatsapp me-2"></i>WhatsApp
                    </a>
                }
                <a href="@Url.Action("Export", new { status = Model.Status })"
                   class="btn btn-sm btn-outline-secondary w-100 text-start">
                    <i class="bi bi-download me-2"></i>Exportar estado "@Model.Status"
                </a>
            </div>
        </div>

        <!-- Eliminar -->
        <div class="stat-card">
            @using (Html.BeginForm("Delete", "Reservations", new { area = "Admin", id = Model.Id }, FormMethod.Post,
                new { onsubmit = "return confirm('¿Estás seguro de eliminar esta cotización? Esta acción no se puede deshacer.')" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="bi bi-trash3 me-2"></i>Eliminar cotización
                </button>
            }
        </div>
    </div>
</div>
