@model IEnumerable<RanchoMvc.Models.Reservation>
@{
    ViewBag.Title = "Cotizaciones";
    var statuses    = ViewBag.Statuses as string[];
    var current     = ViewBag.CurrentStatus as string;
    var plans       = ViewBag.Plans as IList<RanchoMvc.Models.Plan>;
    var currentPlan = ViewBag.CurrentPlanId as int?;
    var currentPay  = ViewBag.CurrentPayment as string;
    var currentFrom = ViewBag.CurrentFrom as string;
    var currentTo   = ViewBag.CurrentTo as string;
    var currentSearch = ViewBag.CurrentSearch as string;
    var totalPages  = (int)(ViewBag.TotalPages ?? 1);
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalCount  = (int)(ViewBag.TotalCount ?? 0);
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-0 fw-semibold">Cotizaciones</h5>
        <span class="text-muted small">@totalCount resultado@(totalCount != 1 ? "s" : "")</span>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Export", new { status = current, planId = currentPlan, paymentMethod = currentPay, from = currentFrom, to = currentTo, search = currentSearch })"
           class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-download me-1"></i>Exportar CSV
        </a>
    </div>
</div>

<!-- Filtros -->
<div class="stat-card mb-3 py-3 px-3">
    <form method="get" action="@Url.Action("Index")" class="row g-2 align-items-end">
        <!-- Búsqueda de texto -->
        <div class="col-12">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@currentSearch"
                       class="form-control" placeholder="Buscar por nombre, email, teléfono o grupo…" />
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a href="@Url.Action("Index", new { status = current, planId = currentPlan, paymentMethod = currentPay, from = currentFrom, to = currentTo })"
                       class="btn btn-outline-secondary" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </div>

        <!-- Status tabs -->
        <div class="col-12">
            <div class="btn-group btn-group-sm flex-wrap">
                <a href="@Url.Action("Index", new { planId = currentPlan, paymentMethod = currentPay, from = currentFrom, to = currentTo, search = currentSearch })"
                   class="btn @(current == null ? "btn-secondary" : "btn-outline-secondary")">Todas</a>
                @foreach (var s in statuses)
                {
                    <a href="@Url.Action("Index", new { status = s, planId = currentPlan, paymentMethod = currentPay, from = currentFrom, to = currentTo, search = currentSearch })"
                       class="btn @(current == s ? "btn-secondary" : "btn-outline-secondary")">@s</a>
                }
            </div>
        </div>

        <!-- Filtros avanzados -->
        <div class="col-sm-4 col-lg-3">
            <label class="form-label mb-1" style="font-size:.75rem;color:#6b7280;text-transform:uppercase;letter-spacing:.05em">Plan</label>
            <select name="planId" class="form-select form-select-sm">
                <option value="">Todos los planes</option>
                @if (plans != null)
                {
                    foreach (var p in plans)
                    {
                        <option value="@p.Id" @(currentPlan == p.Id ? "selected" : "")>@p.Title</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-4 col-lg-2">
            <label class="form-label mb-1" style="font-size:.75rem;color:#6b7280;text-transform:uppercase;letter-spacing:.05em">Pago</label>
            <select name="paymentMethod" class="form-select form-select-sm">
                <option value="">Cualquiera</option>
                <option value="ventanilla" @(currentPay == "ventanilla" ? "selected" : "")>Ventanilla</option>
                <option value="online" @(currentPay == "online" ? "selected" : "")>Online</option>
            </select>
        </div>
        <div class="col-sm-4 col-lg-2">
            <label class="form-label mb-1" style="font-size:.75rem;color:#6b7280;text-transform:uppercase;letter-spacing:.05em">Desde</label>
            <input type="date" name="from" value="@currentFrom" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4 col-lg-2">
            <label class="form-label mb-1" style="font-size:.75rem;color:#6b7280;text-transform:uppercase;letter-spacing:.05em">Hasta</label>
            <input type="date" name="to" value="@currentTo" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-auto">
            <input type="hidden" name="status" value="@current" />
            <button type="submit" class="btn btn-sm" style="background:var(--ranch-green);color:white">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary ms-1">Limpiar</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="stat-card p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:46px;padding-left:1rem"></th>
                    <th>Familia / Grupo</th>
                    <th>Contacto</th>
                    <th>Plan</th>
                    <th class="text-center">Personas</th>
                    <th>Fecha pref.</th>
                    <th>Pago</th>
                    <th>Estado</th>
                    <th>Recibido</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr onclick="location.href='@Url.Action("Details", new{id=r.Id})'" style="cursor:pointer">
                        <td onclick="event.stopPropagation()" style="padding-left:1rem">
                            <a href="@Url.Action("Details", new{id=r.Id})"
                               class="btn btn-sm btn-outline-secondary" style="padding:.2rem .5rem">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                        <td class="fw-medium">
                            @(string.IsNullOrEmpty(r.CompanyName) ? "—" : r.CompanyName)
                        </td>
                        <td>
                            <div class="small fw-medium">@r.ContactName</div>
                            <div class="text-muted" style="font-size:.72rem">@r.Email</div>
                        </td>
                        <td class="small text-muted">@(r.Plan != null ? r.Plan.Title : "—")</td>
                        <td class="text-center small">@r.GuestCount</td>
                        <td class="small">@(r.PreferredDate.HasValue ? r.PreferredDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                        <td>
                            <span class="badge" style="background:#f3f4f6;color:#4b5563;border:1px solid #e5e7eb;font-weight:500">
                                @(r.PaymentMethod == "online" ? "Online" : "Ventanilla")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(r.Status=="Confirmada"?"badge-confirmed":r.Status=="Cancelada"?"badge-cancelled":r.Status=="Pendiente de Pago"?"badge-pay":"badge-pending")">
                                @r.Status
                            </span>
                        </td>
                        <td class="text-muted small">@r.CreatedAt.ToString("dd/MM/yy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
                <line x1="10" y1="15" x2="14" y2="15"/><line x1="10" y1="18" x2="14" y2="18"/>
            </svg>
            <p>No hay cotizaciones@(current != null ? " con estado \"" + current + "\"" : "") que coincidan con los filtros.</p>
            @if (current != null || currentPlan.HasValue || !string.IsNullOrEmpty(currentPay))
            {
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary mt-2">Limpiar filtros</a>
            }
        </div>
    }
</div>

<!-- Paginación -->
@if (totalPages > 1)
{
    <div class="d-flex justify-content-center align-items-center gap-1 mt-3">
        @if (currentPage > 1)
        {
            <a href="@Url.Action("Index", new { status = current, planId = currentPlan, paymentMethod = currentPay, from = currentFrom, to = currentTo, search = currentSearch, page = currentPage - 1 })"
               class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i></a>
        }
        @for (int p = 1; p <= totalPages; p++)
        {
            if (p == currentPage)
            {
                <span class="btn btn-sm" style="background:var(--ranch-green);color:white;pointer-events:none">@p</span>
            }
            else if (p == 1 || p == totalPages || Math.Abs(p - currentPage) <= 1)
            {
                <a href="@Url.Action("Index", new { status = current, planId = currentPlan, paymentMethod = currentPay, from = currentFrom, to = currentTo, search = currentSearch, page = p })"
                   class="btn btn-sm btn-outline-secondary">@p</a>
            }
            else if (Math.Abs(p - currentPage) == 2)
            {
                <span class="text-muted px-1">…</span>
            }
        }
        @if (currentPage < totalPages)
        {
            <a href="@Url.Action("Index", new { status = current, planId = currentPlan, paymentMethod = currentPay, from = currentFrom, to = currentTo, search = currentSearch, page = currentPage + 1 })"
               class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-right"></i></a>
        }
    </div>
}
