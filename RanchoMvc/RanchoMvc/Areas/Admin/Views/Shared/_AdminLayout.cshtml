<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " – " : "")Admin · Rancho Experience</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --sidebar-w: 260px;
            --ranch-green: #2D5016;
            --ranch-green-dark: #1e3810;
            --ranch-gold: #C4882A;
            --ranch-gold-light: #f0b84a;
            --topbar-h: 60px;
            --bg: #f0f2f0;
            --card-shadow: 0 2px 8px rgba(0,0,0,.07), 0 0 1px rgba(0,0,0,.06);
        }

        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); margin: 0; }

        /* ── Sidebar ── */
        .sidebar {
            width: var(--sidebar-w);
            min-height: 100vh;
            background: var(--ranch-green);
            position: fixed; top: 0; left: 0; z-index: 200;
            display: flex; flex-direction: column;
            box-shadow: 2px 0 12px rgba(0,0,0,.15);
            transition: transform .28s cubic-bezier(.4,0,.2,1);
        }
        .sidebar-brand {
            padding: 1.25rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
            display: flex; align-items: center; gap: .75rem;
        }
        .sidebar-brand-icon {
            width: 38px; height: 38px; background: var(--ranch-gold);
            border-radius: 10px; display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; color: white; flex-shrink: 0;
        }
        .sidebar-brand-title { color: white; font-weight: 700; font-size: .9rem; margin: 0; line-height: 1.2; }
        .sidebar-brand-sub { color: rgba(255,255,255,.45); font-size: .7rem; margin: 0; }

        .sidebar-nav { padding: .75rem 0; flex: 1; overflow-y: auto; }
        .sidebar-nav .nav-section {
            color: rgba(255,255,255,.3); font-size: .65rem;
            text-transform: uppercase; letter-spacing: .1em;
            padding: 1rem 1.25rem .3rem;
        }
        .sidebar-nav .nav-link {
            color: rgba(255,255,255,.72);
            padding: .55rem 1rem .55rem 1.25rem;
            display: flex; align-items: center; gap: .65rem;
            font-size: .845rem; font-weight: 450;
            border-left: 3px solid transparent;
            transition: all .18s;
            margin: 1px 0;
        }
        .sidebar-nav .nav-link i { font-size: .95rem; opacity: .85; }
        .sidebar-nav .nav-link .nav-badge {
            margin-left: auto;
            background: var(--ranch-gold); color: white;
            font-size: .6rem; font-weight: 700;
            padding: 1px 6px; border-radius: 10px; line-height: 1.4;
        }
        .sidebar-nav .nav-link:hover {
            background: rgba(255,255,255,.09);
            color: white;
            border-left-color: rgba(196,136,42,.5);
        }
        .sidebar-nav .nav-link.active {
            background: rgba(255,255,255,.14);
            color: white;
            border-left-color: var(--ranch-gold);
            font-weight: 600;
        }
        .sidebar-nav .nav-link.active i { opacity: 1; }

        .sidebar-user {
            padding: .85rem 1.25rem;
            border-top: 1px solid rgba(255,255,255,.1);
            display: flex; align-items: center; gap: .75rem;
        }
        .sidebar-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--ranch-gold); color: white;
            display: flex; align-items: center; justify-content: center;
            font-size: .75rem; font-weight: 700; flex-shrink: 0;
        }
        .sidebar-user-name { color: white; font-size: .8rem; font-weight: 500; line-height: 1.2; }
        .sidebar-user-role { color: rgba(255,255,255,.45); font-size: .68rem; }
        .sidebar-user-actions { margin-left: auto; display: flex; gap: .25rem; }
        .sidebar-icon-btn {
            background: none; border: none; color: rgba(255,255,255,.5);
            padding: .3rem; border-radius: 6px; cursor: pointer;
            transition: all .15s; font-size: .9rem; line-height: 1;
        }
        .sidebar-icon-btn:hover { color: white; background: rgba(255,255,255,.1); }

        /* ── Overlay mobile ── */
        .sidebar-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,.45); z-index: 199;
        }
        .sidebar-overlay.show { display: block; }

        /* ── Main content ── */
        .main-content { margin-left: var(--sidebar-w); min-height: 100vh; display: flex; flex-direction: column; }

        /* ── Topbar ── */
        .topbar {
            background: white; height: var(--topbar-h);
            border-bottom: 1px solid #e5e7eb;
            padding: 0 1.5rem;
            display: flex; align-items: center; gap: 1rem;
            position: sticky; top: 0; z-index: 100;
            box-shadow: 0 1px 4px rgba(0,0,0,.04);
        }
        .topbar-hamburger {
            display: none; background: none; border: none;
            padding: .35rem; border-radius: 6px; cursor: pointer;
            color: #6b7280; font-size: 1.2rem; line-height: 1;
            transition: .15s;
        }
        .topbar-hamburger:hover { background: #f3f4f6; color: #374151; }
        .topbar-breadcrumb { display: flex; align-items: center; gap: .4rem; flex: 1; }
        .topbar-breadcrumb .breadcrumb-root { color: #9ca3af; font-size: .8rem; }
        .topbar-breadcrumb .breadcrumb-sep { color: #d1d5db; font-size: .7rem; }
        .topbar-breadcrumb .breadcrumb-current { color: #374151; font-size: .875rem; font-weight: 600; }
        .topbar-actions { display: flex; align-items: center; gap: .75rem; }
        .topbar-notify-btn {
            position: relative; background: none; border: none;
            padding: .4rem; border-radius: 8px; cursor: pointer;
            color: #6b7280; font-size: 1.1rem; line-height: 1;
            transition: .15s;
        }
        .topbar-notify-btn:hover { background: #f3f4f6; color: #374151; }
        .topbar-notify-dot {
            position: absolute; top: 4px; right: 4px;
            width: 8px; height: 8px; border-radius: 50%;
            background: #ef4444; border: 2px solid white;
        }
        .topbar-view-site {
            font-size: .8rem; color: #6b7280; text-decoration: none;
            display: flex; align-items: center; gap: .3rem;
            padding: .35rem .75rem; border-radius: 8px;
            border: 1px solid #e5e7eb; transition: .15s;
        }
        .topbar-view-site:hover { color: var(--ranch-green); border-color: var(--ranch-green); }

        /* ── Page ── */
        .page-content { padding: 1.5rem; flex: 1; }

        /* ── Cards ── */
        .stat-card {
            background: white; border-radius: 14px;
            padding: 1.35rem 1.5rem;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(0,0,0,.04);
        }

        /* ── Stat cards ── */
        .kpi-card {
            background: white; border-radius: 14px;
            padding: 1.35rem 1.5rem;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(0,0,0,.04);
            display: flex; align-items: center; gap: 1rem;
            transition: box-shadow .2s, transform .2s;
        }
        .kpi-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.1); transform: translateY(-1px); }
        .kpi-icon {
            width: 52px; height: 52px; border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.35rem; flex-shrink: 0;
        }
        .kpi-icon.green { background: #e8f4e8; color: var(--ranch-green); }
        .kpi-icon.gold  { background: #fef3e0; color: var(--ranch-gold); }
        .kpi-icon.blue  { background: #e0f0ff; color: #2563eb; }
        .kpi-icon.rose  { background: #fce7f3; color: #db2777; }
        .kpi-value { font-size: 1.9rem; font-weight: 800; color: #111827; line-height: 1; }
        .kpi-label { font-size: .75rem; color: #6b7280; font-weight: 500; text-transform: uppercase; letter-spacing: .06em; margin-top: .2rem; }

        /* ── Badges ── */
        .badge-pending   { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
        .badge-confirmed { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
        .badge-cancelled { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
        .badge-pay       { background: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd; }

        /* ── Tables ── */
        .table th { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: #9ca3af; font-weight: 600; border-bottom-width: 1px !important; }
        .table td { vertical-align: middle; font-size: .875rem; }
        .table-hover tbody tr:hover { background: #f9fafb; }
        .table thead { position: sticky; top: 0; background: white; }

        /* ── Alerts ── */
        .alert { border-radius: 10px; font-size: .875rem; border: none; }
        .alert-success { background: #d1fae5; color: #065f46; }
        .alert-danger  { background: #fee2e2; color: #991b1b; }

        /* ── Empty state ── */
        .empty-state { text-align: center; padding: 3.5rem 1rem; color: #9ca3af; }
        .empty-state svg { margin-bottom: 1rem; opacity: .5; }
        .empty-state p { font-size: .9rem; margin: 0; }

        /* ── Responsive ── */
        @@media (max-width: 991px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .topbar-hamburger { display: flex; align-items: center; }
        }
    </style>
</head>
<body>
    @{
        bool _isSA = ViewBag.IsSuperAdmin == true;
        var _perms = ViewBag.UserPerms as System.Collections.Generic.Dictionary<string, RanchoMvc.Models.UserModulePermission>;
        Func<string, bool> _canView = m => _isSA || (_perms != null && _perms.ContainsKey(m) && _perms[m].CanView);
        string _ctrl = (string)ViewContext.RouteData.Values["controller"] ?? "";

        int _pendingRes = ViewBag.PendingResCount != null ? (int)ViewBag.PendingResCount : 0;
        int _unreadMsg  = ViewBag.UnreadMsgCount  != null ? (int)ViewBag.UnreadMsgCount  : 0;

        string _userName = User.Identity.Name ?? "";
        string _initials = _userName.Length > 0
            ? (_userName.Contains("@")
                ? _userName[0].ToString().ToUpper()
                : string.Join("", _userName.Split(' ').Select(w => w[0]).Take(2)).ToUpper())
            : "U";
    }

    <!-- Overlay mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon"><i class="bi bi-tree"></i></div>
            <div>
                <p class="sidebar-brand-title">Rancho Experience</p>
                <p class="sidebar-brand-sub">Panel Admin</p>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">Principal</div>
            <a href="@Url.Action("Index","Dashboard",new{area="Admin"})"
               class="nav-link @(_ctrl=="Dashboard"?"active":"")">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>

            @if (_canView(RanchoMvc.Models.AdminModule.Plans) || _canView(RanchoMvc.Models.AdminModule.Gallery))
            {
                <div class="nav-section">Contenido</div>
                if (_canView(RanchoMvc.Models.AdminModule.Plans))
                {
                    <a href="@Url.Action("Index","Plans",new{area="Admin"})"
                       class="nav-link @(_ctrl=="Plans"?"active":"")">
                        <i class="bi bi-card-list"></i> Planes
                    </a>
                }
                if (_canView(RanchoMvc.Models.AdminModule.Gallery))
                {
                    <a href="@Url.Action("Index","Gallery",new{area="Admin"})"
                       class="nav-link @(_ctrl=="Gallery"?"active":"")">
                        <i class="bi bi-images"></i> Galería
                    </a>
                }
            }

            @if (_canView(RanchoMvc.Models.AdminModule.Reservations) || _canView(RanchoMvc.Models.AdminModule.Messages))
            {
                <div class="nav-section">Negocio</div>
                if (_canView(RanchoMvc.Models.AdminModule.Reservations))
                {
                    <a href="@Url.Action("Index","Reservations",new{area="Admin"})"
                       class="nav-link @(_ctrl=="Reservations"?"active":"")">
                        <i class="bi bi-calendar-check"></i> Cotizaciones
                        @if (_pendingRes > 0) { <span class="nav-badge">@_pendingRes</span> }
                    </a>
                }
                if (_canView(RanchoMvc.Models.AdminModule.Messages))
                {
                    <a href="@Url.Action("Index","Messages",new{area="Admin"})"
                       class="nav-link @(_ctrl=="Messages"?"active":"")">
                        <i class="bi bi-envelope"></i> Mensajes
                        @if (_unreadMsg > 0) { <span class="nav-badge">@_unreadMsg</span> }
                    </a>
                }
            }

            @if (_canView(RanchoMvc.Models.AdminModule.Settings) || _isSA)
            {
                <div class="nav-section">Configuración</div>
                if (_canView(RanchoMvc.Models.AdminModule.Settings))
                {
                    <a href="@Url.Action("Index","Settings",new{area="Admin"})"
                       class="nav-link @(_ctrl=="Settings"?"active":"")">
                        <i class="bi bi-sliders2"></i> Ajustes del Sitio
                    </a>
                }
                if (_isSA)
                {
                    <a href="@Url.Action("Index","Users",new{area="Admin"})"
                       class="nav-link @(_ctrl=="Users"?"active":"")">
                        <i class="bi bi-people-fill"></i> Usuarios
                    </a>
                }
            }
        </nav>

        <!-- User info + actions -->
        <div class="sidebar-user">
            <div class="sidebar-avatar">@_initials</div>
            <div>
                <div class="sidebar-user-name">@(_userName.Length > 22 ? _userName.Substring(0,20)+"…" : _userName)</div>
                <div class="sidebar-user-role">@(_isSA ? "Super Admin" : "Administrador")</div>
            </div>
            <div class="sidebar-user-actions">
                @using (Html.BeginForm("Logout","Account",FormMethod.Post, new{area=""}))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-icon-btn" title="Cerrar sesión">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                }
            </div>
        </div>
    </aside>

    <!-- Main -->
    <div class="main-content">
        <div class="topbar">
            <button class="topbar-hamburger" id="sidebarToggle" onclick="toggleSidebar()" aria-label="Menú">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-breadcrumb">
                <span class="breadcrumb-root">Admin</span>
                <i class="bi bi-chevron-right breadcrumb-sep"></i>
                <span class="breadcrumb-current">@(ViewBag.Title ?? "Dashboard")</span>
            </div>

            <div class="topbar-actions">
                @if (_pendingRes > 0 || _unreadMsg > 0)
                {
                    <button class="topbar-notify-btn" title="Tienes notificaciones pendientes">
                        <i class="bi bi-bell"></i>
                        <span class="topbar-notify-dot"></span>
                    </button>
                }
                <a href="@Url.Action("Index","Home",new{area=""})" target="_blank" class="topbar-view-site">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span class="d-none d-sm-inline">Ver sitio</span>
                </a>
            </div>
        </div>

        <div class="page-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["Success"]</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@TempData["Error"]</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('show');
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
