<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " – " : "")Admin · Rancho Experience</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root {
            --sidebar-w: 240px;
            --ranch-green: #2D5016;
            --ranch-gold: #C4882A;
        }
        body { font-family: 'Inter', sans-serif; background: #f4f6f4; }
        .sidebar { width: var(--sidebar-w); min-height: 100vh; background: var(--ranch-green); position: fixed; top: 0; left: 0; z-index: 100; display: flex; flex-direction: column; }
        .sidebar-brand { padding: 1.5rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar-brand-title { color: white; font-weight: 600; font-size: 1rem; margin: 0; }
        .sidebar-brand-sub { color: rgba(255,255,255,.5); font-size: .75rem; }
        .sidebar-nav { padding: 1rem 0; flex: 1; }
        .sidebar-nav .nav-link { color: rgba(255,255,255,.75); padding: .6rem 1.25rem; display: flex; align-items: center; gap: .6rem; font-size: .875rem; border-radius: 0; transition: all .2s; }
        .sidebar-nav .nav-link:hover, .sidebar-nav .nav-link.active { background: rgba(255,255,255,.12); color: white; }
        .sidebar-nav .nav-link i { font-size: 1rem; }
        .sidebar-nav .nav-section { color: rgba(255,255,255,.35); font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; padding: 1rem 1.25rem .4rem; }
        .sidebar-footer { padding: 1rem 1.25rem; border-top: 1px solid rgba(255,255,255,.1); }
        .main-content { margin-left: var(--sidebar-w); min-height: 100vh; }
        .topbar { background: white; border-bottom: 1px solid #e5e7eb; padding: .75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
        .page-content { padding: 1.5rem; }
        .stat-card { background: white; border-radius: 12px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
        .stat-value { font-size: 2rem; font-weight: 700; color: var(--ranch-green); }
        .stat-label { font-size: .8rem; color: #6b7280; text-transform: uppercase; letter-spacing: .05em; }
        .badge-pending { background: #fef3c7; color: #92400e; }
        .badge-confirmed { background: #d1fae5; color: #065f46; }
        .badge-cancelled { background: #fee2e2; color: #991b1b; }
        @@media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); transition: .3s; }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <p class="sidebar-brand-title"><i class="fa-solid fa-leaf me-2"></i>Rancho Experience</p>
            <p class="sidebar-brand-sub">Panel de Administración</p>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-section">Principal</div>
            <a href="@Url.Action("Index","Dashboard",new{area="Admin"})"
               class="nav-link @((string)ViewContext.RouteData.Values["controller"]=="Dashboard"?"active":"")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            <div class="nav-section">Contenido</div>
            <a href="@Url.Action("Index","Plans",new{area="Admin"})"
               class="nav-link @((string)ViewContext.RouteData.Values["controller"]=="Plans"?"active":"")">
                <i class="bi bi-card-list"></i> Planes
            </a>
            <a href="@Url.Action("Index","Gallery",new{area="Admin"})"
               class="nav-link @((string)ViewContext.RouteData.Values["controller"]=="Gallery"?"active":"")">
                <i class="bi bi-images"></i> Galería
            </a>
            <div class="nav-section">Negocio</div>
            <a href="@Url.Action("Index","Reservations",new{area="Admin"})"
               class="nav-link @((string)ViewContext.RouteData.Values["controller"]=="Reservations"?"active":"")">
                <i class="bi bi-calendar-check"></i> Cotizaciones
            </a>
            <a href="@Url.Action("Index","Messages",new{area="Admin"})"
               class="nav-link @((string)ViewContext.RouteData.Values["controller"]=="Messages"?"active":"")">
                <i class="bi bi-envelope"></i> Mensajes
            </a>
            <div class="nav-section">Configuración</div>
            <a href="@Url.Action("Index","Settings",new{area="Admin"})"
               class="nav-link @((string)ViewContext.RouteData.Values["controller"]=="Settings"?"active":"")">
                <i class="bi bi-sliders"></i> Ajustes del Sitio
            </a>
        </nav>
        <div class="sidebar-footer">
            @using (Html.BeginForm("Logout","Account",FormMethod.Post, new{area=""}))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light w-100">
                    <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                </button>
            }
            <a href="@Url.Action("Index","Home",new{area=""})" class="btn btn-sm btn-link text-white-50 w-100 mt-1">
                <i class="bi bi-house me-1"></i>Ver sitio
            </a>
        </div>
    </aside>

    <!-- Main -->
    <div class="main-content">
        <div class="topbar">
            <button class="btn btn-sm btn-outline-secondary d-md-none" onclick="document.getElementById('sidebar').classList.toggle('show')">
                <i class="bi bi-list"></i>
            </button>
            <h6 class="mb-0 fw-semibold">@ViewBag.Title</h6>
            <span class="text-muted small">@User.Identity.Name</span>
        </div>

        <div class="page-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
