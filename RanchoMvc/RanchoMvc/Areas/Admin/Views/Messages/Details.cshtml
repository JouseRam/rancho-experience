@model RanchoMvc.Models.ContactMessage
@{
    ViewBag.Title = "Mensaje";
}

<div class="mb-4">
    <a href="@Url.Action("Index")" class="text-muted small text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i>Volver a Mensajes
    </a>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="fw-semibold mb-0">@Model.Name</h5>
                    @if (!string.IsNullOrEmpty(Model.Company))
                    {
                        <p class="text-muted small mb-0">@Model.Company</p>
                    }
                </div>
                <span class="text-muted small">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase">Correo</label>
                    <p class="mb-0"><a href="mailto:@Model.Email">@Model.Email</a></p>
                </div>
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase">Teléfono</label>
                        <p class="mb-0">@Model.Phone</p>
                    </div>
                }
            </div>
            <div>
                <label class="text-muted small text-uppercase">Mensaje</label>
                <div class="bg-light p-3 rounded mt-1" style="white-space:pre-wrap">@Model.Message</div>
            </div>
            <div class="mt-4">
                <a href="mailto:@Model.Email?subject=Re: Tu mensaje a Rancho Experience" class="btn btn-sm" style="background:#2D5016;color:white;">
                    <i class="bi bi-reply me-2"></i>Responder por Email
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            @using (Html.BeginForm("Delete","Messages",new{area="Admin",id=Model.Id},FormMethod.Post,new{onsubmit="return confirm('¿Eliminar este mensaje?')"}))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="bi bi-trash me-2"></i>Eliminar Mensaje
                </button>
            }
        </div>
    </div>
</div>
