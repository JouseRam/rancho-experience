@model RanchoMvc.Models.ViewModels.UserEditViewModel
@using RanchoMvc.Models
@{
    ViewBag.Title = Model.IsNew ? "Nuevo Usuario" : "Editar Usuario";
    bool isCurrentUser = ViewBag.IsCurrentUser == true;
}

<div class="mb-4">
    <h5 class="mb-1 fw-semibold">@ViewBag.Title</h5>
    <p class="text-muted small mb-0">
        @if (Model.IsNew)
        {
            <text>Define el correo, contraseña y permisos del nuevo usuario.</text>
        }
        else
        {
            <text>Modifica los datos y permisos de acceso del usuario.</text>
        }
    </p>
</div>

@using (Html.BeginForm(Model.IsNew ? "Create" : "Edit", "Users", new { area = "Admin" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.IsNew)

    <div class="row g-4">
        <!-- Columna izquierda: datos del usuario -->
        <div class="col-lg-5">
            <div class="stat-card">
                <h6 class="fw-semibold mb-3 pb-2 border-bottom">
                    <i class="bi bi-person me-2"></i>Datos del Usuario
                </h6>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-medium small" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "correo@ejemplo.com", @readonly = !Model.IsNew ? "readonly" : null })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    @if (!Model.IsNew)
                    {
                        <small class="text-muted">El correo no se puede cambiar.</small>
                    }
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label fw-medium small" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = Model.IsNew ? "Mínimo 6 caracteres" : "Dejar vacío para no cambiar", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-medium small" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repite la contraseña", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                @if (!isCurrentUser)
                {
                    <div class="mb-3 p-3 rounded" style="background:#f8f6f1;border:1px solid #e5e7eb;">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.IsSuperAdmin, new { @class = "form-check-input", id = "chkSuperAdmin", role = "switch" })
                            <label class="form-check-label fw-semibold" for="chkSuperAdmin">
                                Super Administrador
                            </label>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Acceso total a todos los módulos, incluyendo Usuarios y Ajustes.
                        </small>
                    </div>
                }
            </div>
        </div>

        <!-- Columna derecha: permisos por módulo -->
        <div class="col-lg-7">
            <div class="stat-card" id="permsCard">
                <h6 class="fw-semibold mb-1 pb-2 border-bottom">
                    <i class="bi bi-shield-lock me-2"></i>Permisos por Módulo
                </h6>
                <p class="text-muted small mb-3">
                    <strong>Ver</strong> — accede al listado. &nbsp;
                    <strong>Editar</strong> — puede crear, modificar y eliminar.
                </p>

                <table class="table table-sm align-middle mb-0" id="permsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Módulo</th>
                            <th class="text-center" style="width:80px;">Ver</th>
                            <th class="text-center" style="width:80px;">Editar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><i class="bi bi-card-list me-2 text-muted"></i>Planes</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.PlansView, new { @class = "form-check-input perm-view", id = "chkPlansView", data_edit = "chkPlansEdit" })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.PlansEdit, new { @class = "form-check-input perm-edit", id = "chkPlansEdit", data_view = "chkPlansView" })
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-calendar-check me-2 text-muted"></i>Reservaciones</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.ReservationsView, new { @class = "form-check-input perm-view", id = "chkReservationsView", data_edit = "chkReservationsEdit" })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.ReservationsEdit, new { @class = "form-check-input perm-edit", id = "chkReservationsEdit", data_view = "chkReservationsView" })
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-envelope me-2 text-muted"></i>Mensajes</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.MessagesView, new { @class = "form-check-input perm-view", id = "chkMessagesView", data_edit = "chkMessagesEdit" })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.MessagesEdit, new { @class = "form-check-input perm-edit", id = "chkMessagesEdit", data_view = "chkMessagesView" })
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-images me-2 text-muted"></i>Galería</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.GalleryView, new { @class = "form-check-input perm-view", id = "chkGalleryView", data_edit = "chkGalleryEdit" })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.GalleryEdit, new { @class = "form-check-input perm-edit", id = "chkGalleryEdit", data_view = "chkGalleryView" })
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-sliders me-2 text-muted"></i>Ajustes del Sitio</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.SettingsView, new { @class = "form-check-input perm-view", id = "chkSettingsView", data_edit = "chkSettingsEdit" })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    @Html.CheckBoxFor(m => m.SettingsEdit, new { @class = "form-check-input perm-edit", id = "chkSettingsEdit", data_view = "chkSettingsView" })
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div id="superAdminNote" class="alert alert-info mt-3 mb-0 d-none py-2">
                    <i class="bi bi-info-circle me-2"></i>
                    Los Super Administradores tienen acceso total — los permisos individuales no aplican.
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-end mt-4">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancelar</a>
        <button type="submit" class="btn px-5" style="background:#2D5016;color:white;">
            <i class="bi bi-floppy me-2"></i>@(Model.IsNew ? "Crear Usuario" : "Guardar Cambios")
        </button>
    </div>
}

@section Scripts {
<script>
    var chkSA = document.getElementById('chkSuperAdmin');
    var permsTable = document.getElementById('permsTable');
    var saNote = document.getElementById('superAdminNote');

    function updateSuperAdmin() {
        if (!chkSA) return;
        var isSA = chkSA.checked;
        if (permsTable) {
            permsTable.querySelectorAll('.form-check-input').forEach(function (cb) {
                cb.disabled = isSA;
            });
        }
        if (saNote) {
            isSA ? saNote.classList.remove('d-none') : saNote.classList.add('d-none');
        }
    }

    // Edit implies View
    document.addEventListener('change', function (e) {
        if (e.target.classList.contains('perm-edit') && e.target.checked) {
            var viewId = e.target.getAttribute('data-view');
            var viewCb = document.getElementById(viewId);
            if (viewCb) viewCb.checked = true;
        }
        if (e.target.classList.contains('perm-view') && !e.target.checked) {
            var editId = e.target.getAttribute('data-edit');
            var editCb = document.getElementById(editId);
            if (editCb) editCb.checked = false;
        }
        if (e.target === chkSA) updateSuperAdmin();
    });

    // Initialize
    updateSuperAdmin();
</script>
}
