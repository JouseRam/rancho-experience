@model IEnumerable<RanchoMvc.Models.ApplicationUser>
@using RanchoMvc.Models
@{
    ViewBag.Title = "Usuarios";
    var allPerms = ViewBag.AllPerms as System.Collections.Generic.List<UserModulePermission> ?? new System.Collections.Generic.List<UserModulePermission>();
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    Func<string, string, bool> hasPerm = (uid, mod) => allPerms.Any(p => p.UserId == uid && p.Module == mod && p.CanView);
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h5 class="mb-1 fw-semibold">Usuarios del Panel</h5>
        <p class="text-muted small mb-0">Crea y gestiona el acceso de cada usuario a los módulos del admin.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn px-4" style="background:#2D5016;color:white;">
        <i class="bi bi-person-plus me-2"></i>Nuevo Usuario
    </a>
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th class="text-center">Tipo</th>
                    <th>Acceso a módulos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    bool isCurrentUser = u.Id == currentUserId;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                     style="width:40px;height:40px;background:#2D5016;font-size:.9rem;flex-shrink:0;">
                                    @u.Email.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div class="fw-medium">@u.Email</div>
                                    @if (isCurrentUser)
                                    {
                                        <small class="text-muted">(tú)</small>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (u.IsSuperAdmin)
                            {
                                <span class="badge" style="background:#2D5016;">Super Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Usuario</span>
                            }
                        </td>
                        <td>
                            @if (u.IsSuperAdmin)
                            {
                                <span class="text-muted small"><i class="bi bi-infinity me-1"></i>Acceso total</span>
                            }
                            else
                            {
                                var modules = AdminModule.All.Where(m => hasPerm(u.Id, m.Key)).ToList();
                                if (modules.Any())
                                {
                                    foreach (var m in modules)
                                    {
                                        <span class="badge me-1 mb-1" style="background:#C4882A;">
                                            <i class="bi @m.Icon me-1"></i>@m.Label
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Sin acceso</span>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("Edit", new { id = u.Id })" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (!isCurrentUser)
                            {
                                using (Html.BeginForm("Delete", "Users", new { area = "Admin", id = u.Id }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('¿Eliminar a @u.Email?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
