<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " | " : "")Rancho Experience</title>
    <meta name="description" content="Experiencias únicas para toda la familia en contacto con la naturaleza. Paseos a caballo, fogatas y más en Rancho El Pato." />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Content/site.css" />
@{
    var _ss = ViewBag.SiteSettings as System.Collections.Generic.Dictionary<string, string>;
    if (_ss == null) { _ss = new System.Collections.Generic.Dictionary<string, string>(); }
    string _colorPrimary, _colorSecondary, _colorAccent, _fontTitle, _fontBody;
    if (!_ss.TryGetValue("ColorPrimary", out _colorPrimary) || string.IsNullOrEmpty(_colorPrimary)) { _colorPrimary = "#2D5016"; }
    if (!_ss.TryGetValue("ColorSecondary", out _colorSecondary) || string.IsNullOrEmpty(_colorSecondary)) { _colorSecondary = "#C4882A"; }
    if (!_ss.TryGetValue("ColorAccent", out _colorAccent) || string.IsNullOrEmpty(_colorAccent)) { _colorAccent = "#5C3A1E"; }
    if (!_ss.TryGetValue("FontTitle", out _fontTitle) || string.IsNullOrEmpty(_fontTitle)) { _fontTitle = "Playfair Display"; }
    if (!_ss.TryGetValue("FontBody", out _fontBody) || string.IsNullOrEmpty(_fontBody)) { _fontBody = "Inter"; }
    var _gfTitle = _fontTitle.Replace(" ", "+");
    var _gfBody  = _fontBody.Replace(" ", "+");
}
    <!-- Google Fonts (dinámico según ajustes) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=@_gfTitle:wght@400;600;700&family=@_gfBody:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <!-- Variables de apariencia (desde Ajustes del Sitio) -->
    <style>
        :root {
            --green:  @_colorPrimary;
            --green2: @_colorPrimary;
            --gold:   @_colorSecondary;
            --gold2:  @_colorSecondary;
            --brown:  @_colorAccent;
        }
        body { font-family: '@_fontBody', sans-serif; }
        h1,h2,h3,h4,h5 { font-family: '@_fontTitle', Georgia, serif; }
        .brand-text { font-family: '@_fontTitle', serif; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-ranch fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index","Home")">
                @if (!string.IsNullOrEmpty((string)ViewBag.LogoUrl))
                {
                    <img src="@ViewBag.LogoUrl" alt="Rancho El Pato" class="brand-logo" />
                }
                else
                {
                    <i class="fa-solid fa-feather brand-icon"></i>
                }
                <span class="brand-text">Rancho El Pato</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="#planes">Planes</a></li>
                    <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contacto">Contacto</a></li>
                    <li class="nav-item">
                        <a class="btn btn-gold btn-sm" href="#reservar">Reservar Ahora</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    @RenderBody()

    <!-- Footer -->
    <footer class="footer-ranch py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="footer-brand mb-3"><i class="fa-solid fa-leaf me-2"></i>Rancho Experience</h5>
                    <p class="text-muted small">Experiencias únicas para toda la familia en contacto con la naturaleza. Creamos recuerdos que duran toda la vida.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="footer-heading mb-3">Planes</h6>
                    <ul class="list-unstyled">
                        <li><a href="#experiencias" class="footer-link">Paseo a Caballo</a></li>
                        <li><a href="#experiencias" class="footer-link">Noches de Fogata</a></li>
                        <li><a href="#experiencias" class="footer-link">Descanso Total</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="footer-heading mb-3">Contacto</h6>
                    <p class="text-muted small">
                        <i class="bi bi-envelope me-2"></i>contacto@ranchoexperience.com<br />
                        <i class="bi bi-whatsapp me-2"></i>+52 (55) 0000-0000<br />
                        <i class="bi bi-geo-alt me-2"></i>México
                    </p>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <div class="text-center text-muted small">
                <p class="mb-0">&copy; @DateTime.Now.Year Rancho Experience. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery (para validaciones) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function () {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    const offset = 80;
                    window.scrollTo({ top: target.offsetTop - offset, behavior: 'smooth' });
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
