<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " | " : "")Rancho Experience</title>
    <meta name="description" content="Experiencias únicas para toda la familia en contacto con la naturaleza. Paseos a caballo, fogatas y más en Rancho El Pato." />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Content/site.css" />
@{
    var _ss = ViewBag.SiteSettings as System.Collections.Generic.Dictionary<string, string>;
    if (_ss == null) { _ss = new System.Collections.Generic.Dictionary<string, string>(); }
    string _colorPrimary, _colorSecondary, _colorAccent, _fontTitle, _fontBody;
    string _colorNavbar, _colorFooter, _colorCrema;
    if (!_ss.TryGetValue("ColorPrimary",   out _colorPrimary)   || string.IsNullOrEmpty(_colorPrimary))   { _colorPrimary   = "#2D5016"; }
    if (!_ss.TryGetValue("ColorSecondary", out _colorSecondary) || string.IsNullOrEmpty(_colorSecondary)) { _colorSecondary = "#8B5E3C"; }
    if (!_ss.TryGetValue("ColorAccent",    out _colorAccent)    || string.IsNullOrEmpty(_colorAccent))    { _colorAccent    = "#5C3A1E"; }
    if (!_ss.TryGetValue("ColorNavbar",    out _colorNavbar)    || string.IsNullOrEmpty(_colorNavbar))    { _colorNavbar    = "#111111"; }
    if (!_ss.TryGetValue("ColorFooter",    out _colorFooter)    || string.IsNullOrEmpty(_colorFooter))    { _colorFooter    = "#1a2e0a"; }
    if (!_ss.TryGetValue("ColorCrema",     out _colorCrema)     || string.IsNullOrEmpty(_colorCrema))     { _colorCrema     = "#f7f4ee"; }
    if (!_ss.TryGetValue("FontTitle",      out _fontTitle)      || string.IsNullOrEmpty(_fontTitle))      { _fontTitle      = "Playfair Display"; }
    if (!_ss.TryGetValue("FontBody",       out _fontBody)       || string.IsNullOrEmpty(_fontBody))       { _fontBody       = "Inter"; }
    var _gfTitle = _fontTitle.Replace(" ", "+");
    var _gfBody  = _fontBody.Replace(" ", "+");
    // Compute RGB channels for secondary color (allows rgba(var(--color2-rgb), alpha) in CSS)
    int _r2 = 139, _g2 = 94, _b2 = 60;
    try {
        var _h2 = _colorSecondary.TrimStart('#');
        if (_h2.Length == 6) { _r2 = Convert.ToInt32(_h2.Substring(0,2),16); _g2 = Convert.ToInt32(_h2.Substring(2,2),16); _b2 = Convert.ToInt32(_h2.Substring(4,2),16); }
    } catch { }
}
    <!-- Google Fonts (dinámico según ajustes) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=@_gfTitle:wght@400;600;700&family=@_gfBody:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <!-- Variables de apariencia (desde Ajustes del Sitio) -->
    <style>
        :root {
            --green:      @_colorPrimary;
            --green2:     @_colorPrimary;
            --gold:       @_colorSecondary;
            --gold2:      @_colorSecondary;
            --brown:      @_colorAccent;
            --color2-rgb: @_r2, @_g2, @_b2;
            --navbar-bg:  @_colorNavbar;
            --footer-bg:  @_colorFooter;
            --cream:      @_colorCrema;
        }
        body { font-family: '@_fontBody', sans-serif; }
        h1,h2,h3,h4,h5 { font-family: '@_fontTitle', Georgia, serif; }
        .brand-text { font-family: '@_fontTitle', serif; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-ranch fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index","Home")">
                @if (!string.IsNullOrEmpty((string)ViewBag.LogoUrl))
                {
                    <img src="@ViewBag.LogoUrl" alt="Rancho El Pato" class="brand-logo" />
                }
                else
                {
                    <i class="fa-solid fa-feather brand-icon"></i>
                }
                <span class="brand-text">Rancho El Pato</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="#planes">Planes</a></li>
                    <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contacto">Contacto</a></li>
                    <li class="nav-item">
                        <a class="btn btn-gold btn-sm" href="#reservar">Reservar Ahora</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    @RenderBody()

    <!-- Footer -->
    @{
        var _fss    = ViewBag.SiteSettings as System.Collections.Generic.Dictionary<string, string>;
        if (_fss == null) { _fss = new System.Collections.Generic.Dictionary<string, string>(); }
        Func<string, string, string> _fs = (k, d) => {
            string _v; return (_fss.TryGetValue(k, out _v) && !string.IsNullOrEmpty(_v)) ? _v : d;
        };
        var _fBizName = _fs("BusinessName", "Rancho El Pato");
        var _fPhone   = _fs("ContactPhone",  "");
        var _fEmail   = _fs("ContactEmail",  "");
        var _fAddr    = _fs("ContactAddress","");
        var _fWa      = _fs("SocialWhatsapp","");
        var _fIg      = _fs("SocialInstagram","");
        var _fFb      = _fs("SocialFacebook","");
        var _fPlans   = ViewBag.FooterPlans as IList<RanchoMvc.Models.Plan>;
    }
    <footer style="background:var(--footer-bg,#1a2e0a);color:rgba(255,255,255,.9);padding:3rem 0 1.5rem">
        <div class="container">
            <div class="row g-4">
                <!-- Columna 1: Marca -->
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @if (!string.IsNullOrEmpty((string)ViewBag.LogoUrl))
                        {
                            <img src="@ViewBag.LogoUrl" alt="@_fBizName" style="height:36px;width:auto;object-fit:contain" />
                        }
                        else
                        {
                            <i class="fa-solid fa-leaf" style="color:#C4882A;font-size:1.3rem"></i>
                        }
                        <span style="font-family:'@_fontTitle',serif;font-weight:700;font-size:1.1rem;color:white">@_fBizName</span>
                    </div>
                    <p style="color:rgba(255,255,255,.65);font-size:.875rem;line-height:1.6">
                        Experiencias únicas para toda la familia en contacto con la naturaleza. Creamos recuerdos que duran toda la vida.
                    </p>
                    @if (!string.IsNullOrEmpty(_fWa) || !string.IsNullOrEmpty(_fIg) || !string.IsNullOrEmpty(_fFb))
                    {
                        <div class="d-flex gap-2 mt-3">
                            @if (!string.IsNullOrEmpty(_fWa))
                            {
                                <a href="https://wa.me/@(_fWa.Replace("+","").Replace(" ","").Replace("-",""))"
                                   target="_blank" rel="noopener"
                                   style="width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;color:white;text-decoration:none;transition:.2s"
                                   onmouseover="this.style.background='rgba(255,255,255,.22)'" onmouseout="this.style.background='rgba(255,255,255,.12)'">
                                    <i class="bi bi-whatsapp"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(_fIg))
                            {
                                <a href="@(_fIg.StartsWith("http") ? _fIg : "https://instagram.com/" + _fIg.TrimStart('@'))"
                                   target="_blank" rel="noopener"
                                   style="width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;color:white;text-decoration:none;transition:.2s"
                                   onmouseover="this.style.background='rgba(255,255,255,.22)'" onmouseout="this.style.background='rgba(255,255,255,.12)'">
                                    <i class="bi bi-instagram"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(_fFb))
                            {
                                <a href="@(_fFb.StartsWith("http") ? _fFb : "https://facebook.com/" + _fFb.TrimStart('@'))"
                                   target="_blank" rel="noopener"
                                   style="width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;color:white;text-decoration:none;transition:.2s"
                                   onmouseover="this.style.background='rgba(255,255,255,.22)'" onmouseout="this.style.background='rgba(255,255,255,.12)'">
                                    <i class="bi bi-facebook"></i>
                                </a>
                            }
                        </div>
                    }
                </div>

                <!-- Columna 2: Planes activos -->
                <div class="col-md-4">
                    <h6 style="color:white;font-weight:600;font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:1rem">Nuestros Planes</h6>
                    <ul class="list-unstyled mb-0">
                        @if (_fPlans != null && _fPlans.Count > 0)
                        {
                            foreach (var _fp in _fPlans)
                            {
                                <li class="mb-2">
                                    <a href="#experiencias" style="color:rgba(255,255,255,.75);text-decoration:none;font-size:.875rem;display:flex;align-items:center;gap:.5rem;transition:.2s"
                                       onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,.75)'">
                                        <i class="@_fp.Icon" style="font-size:.8rem;opacity:.7;width:16px;text-align:center"></i>
                                        @_fp.Title
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li><a href="#experiencias" style="color:rgba(255,255,255,.75);text-decoration:none;font-size:.875rem">Ver experiencias</a></li>
                        }
                    </ul>
                </div>

                <!-- Columna 3: Contacto -->
                <div class="col-md-4">
                    <h6 style="color:white;font-weight:600;font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:1rem">Contacto</h6>
                    <ul class="list-unstyled mb-0">
                        @if (!string.IsNullOrEmpty(_fEmail))
                        {
                            <li class="mb-2">
                                <a href="mailto:@_fEmail" style="color:rgba(255,255,255,.75);text-decoration:none;font-size:.875rem;display:flex;align-items:center;gap:.6rem">
                                    <i class="bi bi-envelope" style="opacity:.7;width:16px;text-align:center"></i>@_fEmail
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(_fPhone))
                        {
                            <li class="mb-2">
                                <a href="tel:@_fPhone" style="color:rgba(255,255,255,.75);text-decoration:none;font-size:.875rem;display:flex;align-items:center;gap:.6rem">
                                    <i class="bi bi-telephone" style="opacity:.7;width:16px;text-align:center"></i>@_fPhone
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(_fAddr))
                        {
                            <li class="mb-2">
                                <span style="color:rgba(255,255,255,.75);font-size:.875rem;display:flex;align-items:flex-start;gap:.6rem">
                                    <i class="bi bi-geo-alt mt-1" style="opacity:.7;width:16px;text-align:center;flex-shrink:0"></i>@_fAddr
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div style="height:1px;background:rgba(255,255,255,.1);margin:2rem 0 1.25rem"></div>
            <div class="text-center" style="color:rgba(255,255,255,.45);font-size:.78rem">
                &copy; @DateTime.Now.Year @_fBizName. Todos los derechos reservados.
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery (para validaciones) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function () {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    const offset = 80;
                    window.scrollTo({ top: target.offsetTop - offset, behavior: 'smooth' });
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
