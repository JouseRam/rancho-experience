@{
    ViewBag.Title = "Pago No Completado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="min-height:70vh;display:flex;align-items:center;background:#f8f6f1;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7 text-center">
                <div class="mb-4">
                    <i class="bi bi-x-circle-fill" style="font-size:5rem;color:#dc3545;"></i>
                </div>
                <h2 class="mb-3" style="font-family:'Playfair Display',serif;">Pago no completado</h2>
                <p class="lead text-muted mb-2">No pudimos procesar tu pago en este momento.</p>
                <p class="text-muted mb-4">Puedes intentarlo de nuevo o elegir pago en ventanilla al llegar al rancho.</p>

                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="/#reservar" class="btn btn-lg px-5 py-3" style="background:#C4882A;color:white;">
                        <i class="bi bi-arrow-repeat me-2"></i>Intentar de nuevo
                    </a>
                    <a href="/" class="btn btn-lg btn-outline-secondary px-5 py-3">
                        <i class="bi bi-house me-2"></i>Volver al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
