<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
    <add name="RanchoDb"
         connectionString="workstation id=RanchoElPato.mssql.somee.com;packet size=4096;user id=Ejosue_SQLLogin_1;pwd=4hxyotbiql;data source=RanchoElPato.mssql.somee.com;persist security info=False;initial catalog=RanchoElPato;TrustServerCertificate=True"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <appSettings>
    <add key="AdminPassword" value="RanchoElPato2026!"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error"
                  xdt:Transform="Replace" />
  </system.web>

  <system.webServer>
    <security xdt:Transform="Insert">
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>

  <entityFramework>
    <defaultConnectionFactory
      type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework"
      xdt:Transform="Replace" />
  </entityFramework>

</configuration>
